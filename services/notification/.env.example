# Server
PORT=4004
NODE_ENV=development

# Redis
REDIS_URL="redis://localhost:6379"

# Service-to-service auth (must match core service)
SERVICE_JWT_SECRET="change-me-service-secret"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3000"

# SendGrid - get API key at https://sendgrid.com (free tier available)
SENDGRID_API_KEY="SG.your-key-here"
EMAIL_FROM="noreply@globaltransact.com"
EMAIL_FROM_NAME="GlobalTransact"

# Fallback SMTP (optional, used if SendGrid not configured)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
