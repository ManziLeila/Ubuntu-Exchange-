# Database (PostgreSQL)
DATABASE_URL="postgresql://gt_user:yourpassword@localhost:5437/globaltransact"

# Server
PORT=4001
NODE_ENV=development

# JWT - use long random strings in production
JWT_SECRET="change-me-to-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Service-to-service auth (must match other services)
SERVICE_JWT_SECRET="change-me-service-secret"

# Redis
REDIS_URL="redis://localhost:6379"

# Internal service URLs
FOREX_SERVICE_URL="http://localhost:4002"
MOMO_SERVICE_URL="http://localhost:4003"
NOTIFICATION_SERVICE_URL="http://localhost:4004"

# App settings (comma-separated FRONTEND_URL = multiple dev origins)
FRONTEND_URL="http://localhost:3000"
# Set to true only for local dev when the UI is opened from varying hostnames (e.g. public IP). Never in production.
# CORS_RELAXED="true"
STALE_RATE_MINUTES=15

# Google OAuth - get from https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
