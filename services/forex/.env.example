# Server
PORT=4002
NODE_ENV=development

# Redis
REDIS_URL="redis://localhost:6379"

# Open Exchange Rates API key - get one free at https://openexchangerates.org
OPEN_EXCHANGE_RATES_APP_ID="your-app-id-here"

FETCH_INTERVAL_MINUTES=5

# Service-to-service auth (must match core service)
SERVICE_JWT_SECRET="change-me-service-secret"

# Internal service URL
CORE_SERVICE_URL="http://localhost:4001"

# Default spreads per corridor
DEFAULT_SPREAD_RWF_GHS=0.025
DEFAULT_SPREAD_RWF_UGX=0.020
DEFAULT_SPREAD_RWF_KES=0.022
DEFAULT_SPREAD_RWF_USD=0.030
DEFAULT_SPREAD_RWF_EUR=0.030
