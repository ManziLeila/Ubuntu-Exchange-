# Core Service
DATABASE_URL="postgresql://gt_user:yourpassword@localhost:5432/globaltransact"
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Service-to-service
SERVICE_JWT_SECRET="change-me-service-secret"

# Redis
REDIS_URL="redis://:yourpassword@localhost:6379"

# Internal service URLs
FOREX_SERVICE_URL="http://localhost:3002"
MOMO_SERVICE_URL="http://localhost:3003"
NOTIFICATION_SERVICE_URL="http://localhost:3004"

# App settings
FRONTEND_URL="http://localhost:3000"
STALE_RATE_MINUTES=15
LOW_LIQUIDITY_THRESHOLD_RWF=5000000
LOW_LIQUIDITY_THRESHOLD_GHS=5000

---

# Forex Service
PORT=3002
NODE_ENV=development
REDIS_URL="redis://:yourpassword@localhost:6379"
OPEN_EXCHANGE_RATES_APP_ID="your-app-id-here"
FETCH_INTERVAL_MINUTES=5
SERVICE_JWT_SECRET="change-me-service-secret"
CORE_SERVICE_URL="http://localhost:3001"

# Default spreads per corridor (admin can override via API)
DEFAULT_SPREAD_RWF_GHS=0.0250
DEFAULT_SPREAD_RWF_UGX=0.0200
DEFAULT_SPREAD_RWF_USD=0.0300

---

# MoMo Service
PORT=3003
NODE_ENV=development
REDIS_URL="redis://:yourpassword@localhost:6379"
SERVICE_JWT_SECRET="change-me-service-secret"
CORE_SERVICE_URL="http://localhost:3001"

# MTN MoMo Rwanda (Collections)
MTN_RW_SUBSCRIPTION_KEY="your-rw-subscription-key"
MTN_RW_API_USER_ID="your-rw-user-id"
MTN_RW_API_KEY="your-rw-api-key"
MTN_RW_TARGET_ENV="sandbox"
MTN_RW_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_RW_CALLBACK_URL="https://your-domain.com/webhooks/momo/callback"

# MTN MoMo Ghana (Disbursements)
MTN_GH_SUBSCRIPTION_KEY="your-gh-subscription-key"
MTN_GH_API_USER_ID="your-gh-user-id"
MTN_GH_API_KEY="your-gh-api-key"
MTN_GH_TARGET_ENV="sandbox"
MTN_GH_BASE_URL="https://sandbox.momodeveloper.mtn.com"

---

# Notification Service
PORT=3004
NODE_ENV=development
REDIS_URL="redis://:yourpassword@localhost:6379"
SERVICE_JWT_SECRET="change-me-service-secret"

# SendGrid
SENDGRID_API_KEY="SG.your-key-here"
EMAIL_FROM="noreply@globaltransact.com"
EMAIL_FROM_NAME="GlobalTransact"

# Fallback SMTP (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
